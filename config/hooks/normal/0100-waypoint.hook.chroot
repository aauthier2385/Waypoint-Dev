#!/bin/sh
# Runs inside the image while it is being built.
set -eu

# VS Code comes from Microsoft's repository. Refuse a key we don't expect.
KEY_URL="https://packages.microsoft.com/keys/microsoft.asc"
KEY_FPR="BC528686B50D79E339D3721CEB3E94ADBE1229CF"
GNUPGHOME="$(mktemp -d)"
export GNUPGHOME
curl -fsSL "$KEY_URL" -o /tmp/microsoft.asc
gpg --batch --import /tmp/microsoft.asc
gpg --batch --with-colons --fingerprint | grep -q "^fpr:*${KEY_FPR}:" || {
  echo "Microsoft signing key did not match the expected fingerprint" >&2
  exit 1
}
install -d -m 0755 /etc/apt/keyrings
gpg --batch --yes --export "$KEY_FPR" > /etc/apt/keyrings/microsoft.gpg
rm -rf "$GNUPGHOME" /tmp/microsoft.asc
unset GNUPGHOME
cat > /etc/apt/sources.list.d/vscode.sources <<'SRC'
Types: deb
URIs: https://packages.microsoft.com/repos/code
Suites: stable
Components: main
Architectures: amd64
Signed-By: /etc/apt/keyrings/microsoft.gpg
SRC
echo "code code/add-microsoft-repo boolean false" | debconf-set-selections
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y code

# Keep Docker out of the way until something actually uses it.
systemctl disable docker.service containerd.service || true
systemctl enable docker.socket || true

# Keep empty /dev/nbd devices out of the installer's boot loader menu.
systemctl enable waypoint-live-disks.service

# The installer picks a boot loader per PC, so keep both ready for offline use.
for kind in grub-pc grub-efi-amd64; do
  dir="/var/cache/waypoint/$kind"
  mkdir -p "$dir/partial"
  apt-get install -y --download-only -o "Dir::Cache::archives=$dir" "$kind"
  rm -rf "$dir/partial" "$dir/lock"
done

# Show Waypoint's name in the installer.
branding=/etc/calamares/branding/debian/branding.desc
sed -i \
  -e 's/^\( *productName: *\).*/\1Waypoint/' \
  -e 's/^\( *shortProductName: *\).*/\1Waypoint/' \
  -e 's/^\( *versionedName: *\).*/\1Waypoint 1/' \
  -e 's/^\( *shortVersionedName: *\).*/\1Waypoint 1/' \
  -e 's/^\( *bootloaderEntryName: *\).*/\1Waypoint/' \
  "$branding"

# Replace the installer's download-based scripts wherever this Debian release keeps them.
# The build stops if a script can't be found, rather than shipping an installer that needs internet.
for name in bootloader-config sources-final; do
  matches="$(find /usr/share/calamares /usr/sbin -type f -name "*$name")"
  if [ -z "$matches" ]; then
    echo "Could not find the installer's $name script" >&2
    exit 1
  fi
  for target in $matches; do
    echo "Replacing $target"
    install -m 0755 "/usr/lib/waypoint/installer/$name" "$target"
  done
done

chmod 0755 /usr/bin/dev /usr/bin/waypoint-welcome /usr/libexec/waypoint/waypoint-helper
