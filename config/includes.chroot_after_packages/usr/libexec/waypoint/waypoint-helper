#!/usr/bin/python3 -I
"""Runs as root through pkexec. It only accepts these fixed actions, and package
names always come from the track list, never from the caller."""
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, "/usr/lib/waypoint")
from waypoint.hardware import secure_boot_enabled  # noqa: E402
from waypoint.tracks import packages_for  # noqa: E402

CLAUDE_KEY_URL = "https://downloads.claude.ai/claude-desktop/key.asc"
CLAUDE_KEY_FINGERPRINT = "31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE"
CLAUDE_KEYRING = "/usr/share/keyrings/claude-desktop-archive-keyring.asc"
CLAUDE_SOURCE = "/etc/apt/sources.list.d/claude-desktop.list"
CLAUDE_REPO = (
    f"deb [arch=amd64,arm64 signed-by={CLAUDE_KEYRING}] "
    "https://downloads.claude.ai/claude-desktop/apt/stable stable main\n"
)

os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
os.environ["DEBIAN_FRONTEND"] = "noninteractive"


def run(*args):
    print("$ " + " ".join(args), flush=True)
    return subprocess.run(args, check=False).returncode


def snapshot(reason):
    """Taking a snapshot matters, but a failed one shouldn't block setup."""
    code = run("timeshift", "--create", "--scripted", "--comments", reason)
    if code != 0:
        print("Couldn't take an undo snapshot. Continuing without one.", flush=True)


def install_tracks(track_ids):
    try:
        packages = packages_for(track_ids)
    except ValueError as error:
        print(error, file=sys.stderr)
        return 2
    snapshot("Before installing developer tools")
    if run("apt-get", "update") != 0:
        print("Couldn't refresh the package list. Check your internet connection.", flush=True)
        return 1
    return run("apt-get", "install", "-y", *packages)


def choose_nvidia_package(detect_output):
    """Pick the package that nvidia-detect recommends. Only exact Debian driver names pass."""
    for line in reversed(detect_output.splitlines()):
        candidate = line.strip()
        if re.fullmatch(r"nvidia(-[a-z0-9]+)*-driver", candidate):
            return candidate
    return None


def gpu_driver():
    if secure_boot_enabled():
        print("Secure Boot is on, so the NVIDIA driver wouldn't load. Keeping the open-source driver.", flush=True)
        return 1
    snapshot("Before installing the NVIDIA driver")
    if run("apt-get", "update") != 0 or run("apt-get", "install", "-y", "nvidia-detect") != 0:
        return 1
    output = subprocess.run(["nvidia-detect"], capture_output=True, text=True, check=False).stdout
    package = choose_nvidia_package(output)
    if not package:
        print("This graphics card isn't supported by the available NVIDIA drivers. Keeping the open-source driver.", flush=True)
        return 1
    return run("apt-get", "install", "-y", package)


def key_fingerprints(key_file):
    """Read a key file's fingerprints without importing it."""
    output = subprocess.run(["gpg", "--batch", "--show-keys", "--with-colons", key_file],
                            capture_output=True, text=True, check=False).stdout
    return [line.split(":")[9] for line in output.splitlines() if line.startswith("fpr:")]


def install_claude():
    with tempfile.TemporaryDirectory() as folder:
        key_file = os.path.join(folder, "key.asc")
        if run("curl", "-fsSL", CLAUDE_KEY_URL, "-o", key_file) != 0:
            print("Couldn't download Claude's signing key. Check your internet connection.", flush=True)
            return 1
        if CLAUDE_KEY_FINGERPRINT not in key_fingerprints(key_file):
            print("Claude's signing key didn't match, so nothing was installed.", flush=True)
            return 1
        shutil.copyfile(key_file, CLAUDE_KEYRING)
        os.chmod(CLAUDE_KEYRING, 0o644)
    with open(CLAUDE_SOURCE, "w", encoding="ascii") as handle:
        handle.write(CLAUDE_REPO)
    if run("apt-get", "update") != 0:
        print("Couldn't refresh the package list. Check your internet connection.", flush=True)
        return 1
    return run("apt-get", "install", "-y", "claude-desktop")


def enable_docker():
    uid = os.environ.get("PKEXEC_UID")
    if not uid or int(uid) == 0:
        print("Run this from your own account.", file=sys.stderr)
        return 2
    user = pwd.getpwuid(int(uid)).pw_name
    code = run("usermod", "-aG", "docker", user)
    if code == 0:
        print("Done. Log out and back in to start using Docker.", flush=True)
    return code


def main(argv):
    if os.geteuid() != 0:
        print("This tool must run through pkexec.", file=sys.stderr)
        return 2
    if len(argv) >= 2 and argv[0] == "install-tracks":
        return install_tracks(argv[1:])
    if argv == ["snapshot"]:
        snapshot("Manual snapshot")
        return 0
    if argv == ["gpu-driver"]:
        return gpu_driver()
    if argv == ["install-claude"]:
        return install_claude()
    if argv == ["enable-docker"]:
        return enable_docker()
    print("Unknown action.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
